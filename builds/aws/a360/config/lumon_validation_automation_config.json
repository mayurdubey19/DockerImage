{
    "bucket_name": "axle-a360-demo-{}",
    "dps_bucket_name": "axle-a360-geha-{}-dps",
    "aws_webapp_bucket_name" : "audience360-sample-ingestion-files",
    "aws_reg_webapp" : "us-east-2",
    "aws_reg_rs": "us-east-2",
    "aws_reg_dp": "us-east-1",
    "aws_reg_mft": "us-east-1",
    "mz360_postgres_secret_name" : "mz360_client_redshift",
    "connections_glue": "Lumon Redshift Connection",
    "a360_global_param": "a360_global_params",
    "secret_name": "mz-aetna-redshift",
    "git_repo_secret_name": "git_repo_config_secrets",
    "redshift_db": "a360_fp_demo",
    "request_type": "1",
    "client_folder": "a360",
    "request_type_mapping": {"Customer_Data_Processing_Daily": "1",
                     "Customer_Data_Processing_Weekly": "2",
                     "Customer_Data_Processing_Monthly": "3",
                     "Transaction_Data_Processing_Daily": "4",
                     "Transaction_Data_Processing_Weekly": "6",
                     "Transaction_Data_Processing_Monthly": "7",
                     "Priority_Data_Processing": "5",
                     "CampaignAndLookup_Data_Processing": "8",
                     "Enrichment_Data_Processing_Daily": "9",
                     "Enrichment_Data_Processing_Weekly": "10",
                     "Enrichment_Data_Processing_Monthly": "11"
                     },
    "s3_key_reject_path": "archive/outbound/rejects/",
    "metric_report_path": "archive/outbound/metrics",
    "s3_key_extracts_path": "archive/outbound/extracts/",
    "mft_bucket": "axle-geha-{}-dps",
    "s3_key_mft_outbound": "outbound/",
    "s3_key_dp_config": "config/dp_config/",
    "s3_key_athena_glue": "process_fcvrl/athena_glue/",
    "s3_key_athena_validation_glue": "process_fcvrl/athena_validation_glue/",
    "company_id": 18,
    "a360_weapp_secret": "a360_ui_notification_api_secrets",
    "match_ai_reg": "us-east-1",
    "mcd_consolidate_prefix": "match_output_firstlogic/consolidate/",
    "match_ai_src_prefix": "MLP_FOLDER/MatchAI/A360_lumon/InputFiles/",
    "match_ai_bucket": "ds-databricks-playground",
    "split_file_maxsize": "2 GB",
    "ingestion_path": "incoming",
    "redshift_cluster": "mz-a360-aetna-redshift",
    "spectrum_schema": "spectrum_demo_validation",
    "dp_config": {
       "daily": {
          "athena_tab_to_dp": "stg_customer_dpinput_daily",
          "athena_tab_from_dp": "stg_customer_dpoutput_daily",
          "outbound": "dps_outbound/AETDEVDLI1/",
          "dp_outbound": "outbound/AETDEVDLI1/",
          "inbound": "dps_inbound/AETDEVDLS3/",
          "dp_inbound": "inbound/AETDEVDLS3/",
          "delimiter": "|",
          "file_format": "TEXTFILE",
          "compression" : "None"
       },
       "weekly": {
          "athena_tab_to_dp": "stg_customer_dpinput_weekly",
          "athena_tab_from_dp": "stg_customer_dpoutput_weekly",
          "athena_partitioned_table":"stg_weekly_dpinput",      
          "outbound": "dps_outbound/A360DLRT/",
          "dp_outbound": "outbound/GEHA2DP/",
          "inbound": "dps_inbound/A360DEVDLS3/",
          "dp_inbound": "inbound/GEHDEVDLS3/",
          "delimiter": "|",
          "file_format": "TEXTFILE",
          "compression" : "None"
        },
       "monthly": {
          "athena_tab_to_dp": "stg_customer_dpinput_monthly",
          "athena_tab_from_dp": "stg_customer_dpoutput_monthly",
          "athena_partitioned_table":"stg_monthly_dpinput",      
          "outbound": "dps_outbound/A360DLRT/",
          "dp_outbound": "outbound/GEHA2DP/",
          "inbound": "dps_inbound/A360DEVDLS3/",
          "dp_inbound": "inbound/GEHDEVDLS3/",
          "delimiter": "|",
          "file_format": "TEXTFILE",
          "compression" : "None"
        },
       "broker": {
          "athena_tab_to_dp": "stg_dpinput_broker",
          "athena_tab_from_dp": "stg_dpoutput_broker",
          "outbound": "dps_outbound/AETDEVBRKI1/",
          "dp_outbound": "outbound/AETDEVBRKI1/",
          "inbound": "dps_inbound/AETDEVBRKS3/",
          "dp_inbound": "inbound/AETDEVBRKS3/"
       },
       "seed_list": {
          "athena_tab_to_dp": "stg_dpinput_seed_list",
          "athena_tab_from_dp": "stg_dpoutput_seed_list",
          "outbound": "dps_outbound/AETDEVSEEDI1/",
          "dp_outbound": "outbound/AETDEVSEEDI1/",
          "inbound": "dps_inbound/AETDEVSEEDS3/",
          "dp_inbound": "inbound/AETDEVSEEDS3/"
       }
    }
}
