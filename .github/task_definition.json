{
  "family": "airflow-git-sync-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "volumes": [
    {
      "name": "dag-volume"
    }
  ],
  "containerDefinitions": [
    {
      "name": "airflow",
      "image": "<ECR_URI>:<tag>",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "AIRFLOW__CORE__SQL_ALCHEMY_CONN", "value": "postgresql+psycopg2://airflow:airflow@<RDS-ENDPOINT>:5432/airflow" },
        { "name": "AIRFLOW__CORE__EXECUTOR", "value": "LocalExecutor" },
        { "name": "AIRFLOW__CORE__FERNET_KEY", "value": "" },
        { "name": "AIRFLOW__CORE__LOAD_EXAMPLES", "value": "false" },
        { "name": "AIRFLOW__WEBSERVER__EXPOSE_CONFIG", "value": "true" },
        { "name": "AIRFLOW__HOME", "value": "/opt/airflow" },
        { "name": "AIRFLOW__CORE__DAGS_FOLDER", "value": "/opt/airflow/dags" },
        { "name": "PYTHONPATH", "value": "/opt/airflow/dags" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "dag-volume",
          "containerPath": "/opt/airflow/dags"
        }
      ]
    },
    {
      "name": "git-sync",
      "image": "k8s.gcr.io/git-sync/git-sync:v3.6.6",
      "essential": false,
      "environment": [
        { "name": "GIT_SYNC_REPO", "value": "https://github.com/<your-org>/<your-dag-repo>.git" },
        { "name": "GIT_SYNC_BRANCH", "value": "main" },
        { "name": "GIT_SYNC_ROOT", "value": "/git" },
        { "name": "GIT_SYNC_ONE_TIME", "value": "false" },
        { "name": "GIT_SYNC_WAIT", "value": "30" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "dag-volume",
          "containerPath": "/git"
        }
      ]
    }
  ]
}
